# ==============================================================================
# ZYRO 24/7 DISCORD STREAMING BOT CONFIGURATION
# ==============================================================================

# Required: Discord Bot Token from Discord Developer Portal
BOT_TOKEN=your_bot_token_here

# Optional: Default Streaming Activity URL (Twitch or YouTube live)
DEFAULT_STREAM_URL=https://www.twitch.tv/example

# Optional: Base Starting Hours for the Timer (Default: 0 - counts up infinitely)
BASE_ELAPSED_HOURS=0

# Optional: HTTP Port for Render / Cloud Health Check (Default: 3000)
PORT=3000

# Optional: Directory for persistent state (timer-state.json, settings.json)
DATA_DIR=./data

# Optional: Development Guild ID for instant slash command registration
DEV_GUILD_ID=
